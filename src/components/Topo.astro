---
// A contour map drawn at build time: a few seeded hills, traced with d3-contour.
// Change `seed` for a different landscape. Ships as plain SVG, no client JS.
import { contours } from 'd3-contour';
import { geoPath, geoTransform } from 'd3-geo';

interface Props {
  seed?: number;
  route?: boolean;
}
const { seed = 1066, route = true } = Astro.props;

const W = 160;
const H = 80;
const SCALE = 10;

// mulberry32: small deterministic PRNG so the map is the same on every build
function rng(a: number) {
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = rng(seed);
const hills = Array.from({ length: 9 }, () => ({
  x: rand() * W,
  y: rand() * H,
  h: 0.4 + rand() * 0.9,
  sx: 10 + rand() * 26,
  sy: 8 + rand() * 18,
}));

const values = new Float64Array(W * H);
for (let y = 0; y < H; y++) {
  for (let x = 0; x < W; x++) {
    let v = 0.08 * Math.sin(x / 9) * Math.cos(y / 7);
    for (const p of hills) {
      v += p.h * Math.exp(-(((x - p.x) / p.sx) ** 2) - ((y - p.y) / p.sy) ** 2);
    }
    values[y * W + x] = v;
  }
}

const levels = Array.from({ length: 22 }, (_, i) => 0.05 + i * 0.075);
const path = geoPath(
  geoTransform({
    point(x, y) {
      this.stream.point(x * SCALE, y * SCALE);
    },
  }),
);
const lines = contours()
  .size([W, H])
  .thresholds(levels)(Array.from(values))
  .map((c, i) => ({ d: path(c) ?? '', index: i % 5 === 4 }));
---

<svg
  class="topo"
  viewBox={`${SCALE * 2} ${SCALE * 2} ${(W - 4) * SCALE} ${(H - 4) * SCALE}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
>
  <g fill="none" stroke-linejoin="round">
    {lines.map((l) => <path d={l.d} class={l.index ? 'contour index' : 'contour'} />)}
  </g>
  {
    route && (
      <g class="route">
        <mask id="route-reveal">
          <path
            class="route-reveal"
            d="M -20 760 C 300 760, 560 700, 820 610 S 1000 380, 1130 420 S 1300 330, 1420 250 S 1560 120, 1640 90"
            pathLength="1"
          />
        </mask>
        <path
          class="route-line"
          mask="url(#route-reveal)"
          d="M -20 760 C 300 760, 560 700, 820 610 S 1000 380, 1130 420 S 1300 330, 1420 250 S 1560 120, 1640 90"
        />
        <circle class="waymark" cx="820" cy="610" r="9" />
        <circle class="waymark" cx="1130" cy="420" r="9" />
        <circle class="waymark" cx="1420" cy="250" r="9" />
      </g>
    )
  }
</svg>

<style>
  .topo {
    display: block;
    width: 100%;
    height: 100%;
  }
  .contour {
    stroke: var(--contour);
    stroke-width: 1.4;
    vector-effect: non-scaling-stroke;
  }
  .contour.index {
    stroke: var(--contour-index);
    stroke-width: 2.2;
  }
  .route-line {
    fill: none;
    stroke: var(--path);
    stroke-width: 5;
    stroke-dasharray: 16 12;
    stroke-linecap: round;
  }
  .route-reveal {
    fill: none;
    stroke: #fff;
    stroke-width: 30;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: walk 3.2s 0.3s cubic-bezier(0.45, 0, 0.2, 1) forwards;
  }
  .waymark {
    fill: var(--paper);
    stroke: var(--path);
    stroke-width: 4;
  }
  @keyframes walk {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .route-reveal {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
